# Wallet that receives payments (any Base Sepolia address you control)
SELLER_PAY_TO=0x0000000000000000000000000000000000000000

# Facilitator: "remote" uses https://x402.org/facilitator (default)
SELLER_FACILITATOR=remote
FACILITATOR_URL=https://x402.org/facilitator

# Published support contact. BillGuard reads these to address disputes.
SUPPORT_EMAIL=support@litigious-seller.example
SUPPORT_PHONE=+15555550100

PORT=8402

# --- Optional: record settled payments to Stripe (machine payments / x402) ---
# Leave STRIPE_SECRET_KEY blank to disable (the seller runs exactly as before).
# Use a Stripe SANDBOX key (sk_test_...) for the demo: no real money, no crypto
# payment-method approval needed. See https://docs.stripe.com/payments/machine/x402
# Workflow:
#   1. STRIPE_SECRET_KEY=sk_test_... uv run python scripts/create_deposit_address.py
#   2. Set SELLER_PAY_TO above to the deposit address it prints.
#   3. Set STRIPE_SECRET_KEY here so settled payments record as PaymentIntents.
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=2026-07-29.preview
STRIPE_PI_NETWORK=base
